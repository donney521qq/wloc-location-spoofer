#!name=Apple WLOC 定位修改
#!desc=Apple 网络定位修改（iOS 编号定位主机兼容版）
#!author=Yu9191 Rewrite / xweiba restoration / donney521qq packaging
#!homepage=https://github.com/donney521qq/wloc-location-spoofer
#!category=Tools

[Script]
Apple WLOC = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp(?:e)?(?:\d+(?:-\d+)*)?(?:-cn)?-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/donney521qq/wloc-location-spoofer/v1.0.0/scripts/wloc.js,argument=longitude=113.94114&latitude=22.544577&accuracy=25&randomRadius=0&logLevel=info
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save,requires-body=0,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/donney521qq/wloc-location-spoofer/v1.0.0/scripts/wloc-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, gsp64-ssl.ls.apple.com, gspe19-2-cn-ssl.ls.apple.com, gspe79-cn-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
